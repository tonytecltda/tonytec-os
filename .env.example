# Copie para .env.local e preencha. NUNCA commite o .env.local.

# --- Supabase (Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Somente no servidor (Vercel: NÃO marcar como exposta ao cliente)
SUPABASE_SERVICE_ROLE_KEY=

# URL pública do app (links de convite, assinatura remota, e-mails)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Somente para scripts locais (migrações/tipos). Não vão para a Vercel. ---
SUPABASE_PROJECT_REF=
# Token pessoal: https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_PASSWORD=

# --- Seed do primeiro admin (npm run seed:admin) — apague a senha depois ---
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Administrador

# --- Dados de demonstração (npm run seed:demo / npm run test:rls) ---
SEED_DEMO=false
SEED_DEMO_PASSWORD=

# --- E-mail transacional (opcional; sem a chave o sistema funciona sem e-mail) ---
RESEND_API_KEY=
EMAIL_FROM="Tonytec <os@seudominio.com.br>"
